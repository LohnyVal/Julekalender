<%- include('partials/head') %>
<body>
    <%- include('partials/nav') %>
    <main class="dashboard-main">
        <div class="dashboard-top">
            <h1>Dashboard</h1>
            <h3>Hei, <%= username %></h3>
        </div>
        <div class="dashboard-middle">
            <div class="data-div box">
                <div class="data-div-top">
                    <h2>Oversikt</h2>
                </div>
                <div class="data-overview-div">
                    <div class="users-amount">
                        <h3><%= userCount %></h3>
                        <p>Deltagere</p>
                    </div>
                    <div class="answers-amount">
                        <h3>35</h3>
                        <p>Antall svar</p>
                    </div>
                    <div class="awaits-correction">
                        <h3>35</h3>
                        <p>Venter svar</p>
                    </div>
                    <div class="day-count">
                        <h3><%= today %></h3>
                        <p>Luke</p>
                    </div>
                </div>
            </div>

            <div class="answer-div box">
                <div class="answer-div-top">
                    <h2>Innsendte svar</h2>
                </div>
                <div class="answer-div-result">
                    <div class="filter-options-div">
                        <form action="" method="post">
                            <select name="filter" id="filter">
                                <option value="all">Alle</option>
                                <option value="correct">Riktig</option>
                                <option value="wrong">Feil</option>
                                <option value="awaits">Venter</option>
                            </select>
                            <select name="days" id="">
                            <% for (let i = 0; i < 24; i++) { %>
                                <option value="<%= i %>"><%= i + 1 %></option>
                            <% } %>
                            </select>
                        </form>
                    </div>
                    <div class="user-results">
                        <div class="result-div-info">
                            <p>Bruker</p>
                            <p>Luke</p>
                            <p>Spørsmål</p>
                            <p>Svar</p>
                            <p>Resultat</p>
                        </div>
                        <% answers.forEach(a => { %>
                            <div class="result">
                                <h3><%= a.username %></h3>
                                <p class="day-text"><%= a.day %></p>
                                <p><%= a.question %></p>
                                <p><%= a.answer %></p>

                                <% if (a.type === "mc") { %>
                                    <% if (a.correct == true) { %>
                                        <p class="correct">Riktig</p>
                                    <% } else if(a.correct === false) { %>
                                        <p class="wrong">Feil</p>
                                    <% } %>
                                <% } else if(a.type === "video" || a.type === "open") { %>
                                    <form action="" method="post">
                                        <button name="result" value="true">Riktig</button>
                                        <button name="result" value="false">Feil</button>
                                    </form>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="pull-random-winner-div box">
                <div class="pull-random-winner-div-top">
                    <h2>Trekk vinner</h2>
                </div>
                <div class="pull-random-winner">
                   <form action="" method="post">
                    <h3>Trekk en tilfeldig vinner</h3>
                    <button>Trekk</button>
                   </form>
                </div>
                
            </div>
            <div class="user-list-div box">
                <div class="user-div-top">
                    <h2>Brukere</h2>
                </div>
                <% users.forEach(user => { %>
                    <div class="users-div">
                        <h4><%= user.username %></h4>
                        <p>Rolle: <%= user.role %></p>
                        <div class="user-left">
                            <p><%= user.email %></p>
                            <span class="profile_of_user"><%= user.username.charAt(0).toUpperCase() %></span>
                        </div>
                    </div>
                <% }) %>
                
            </div>
        </div>
    </main>
</body>
