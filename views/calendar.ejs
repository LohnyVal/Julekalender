<%- include('partials/head') %>
<body>
    <%- include('partials/nav') %>
    <main class="calendar-main">
        <% if(q.type === "multiple_choice"){ %>
            <div class="calendar-wrapper-multiple">
                <div class="calendar-multiple-top">
                    <h1><%= q.question %></h1>
                </div>
                <div class="calendar-multiple-bottom">
                    <form action="/calendar/<%= id %>" method="post">
                        <% q.options.forEach(btn =>{ %>
                            <button type="submit" name="answer" value="<%= btn %>"> <%= btn %></button>
                       <% }) %>
                    </form>
                </div>
            </div>
        <% } %>
        <% if(q.type === "open"){ %>
            <div class="calendar-wrapper-open">
                <div class="calendar-open-top">
                    <h1><%= q.question %></h1>
                </div>
                <div class="calendar-open-bottom">
                    <form action="/calendar/<%= id %>" method="post">
                        <textarea name="answer" required></textarea>
                        <button type="submit">Svar</button>
                    </form>
                </div>
            </div>
        <% } %>
        <% if(q.type === "video"){ %>
            <div class="calendar-wrapper-video">
                <div class="calendar-video-top">
                    <h1><%= q.question %></h1>
                </div>
                <div class="calendar-video-bottom">
                    <iframe src="<%= q.video_url.replace('watch?v=', 'embed/') %>" frameborder="0" allowfullscreen ></iframe>
                    <form action="/calendar/<%= id %>" method="post">
                        <textarea name="answer"  required></textarea>
                        <button type="submit">Svar</button>
                    </form>
                </div>
            </div>
        <% } %>
    </main>
</body>