<%- include('partials/head') %>
<body>
    <%- include('partials/nav') %>
    <main class="admin-main">
        <div class="textConatiner">
            <p class="month-text">Desember 2026</p>
            <h1>Bleiker julekalnder</h1>
            <p class="info-text">Åpne en ny luke hver dag og svar på et spørsmål for å være med i trekningen av en premiere</p>
        </div>
        <div class="daysContainer">
            <% calendar_array.forEach(nr => { %>
                <a target="_blank" href="/calendar/<%= nr %>">
                <div class="days"><%= nr %></div>
                </a>
            <% }) %>
        </div>
    </main>
</body>
</html>